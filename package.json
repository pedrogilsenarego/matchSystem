{
  "name": "fe-exercise-scoreboard",
  "private": true,
  "type": "module",
  "description": "Frontend exercise: real-time scoreboard dashboard with Module Federation",
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint apps libs",
    "lint:fix": "eslint apps libs --fix",
    "dev:host": "npm run dev --workspace=apps/host",
    "dev:scoreboard": "npm run dev --workspace=apps/scoreboard",
    "dev:ws": "npm run dev --workspace=apps/ws-server",
    "build:design-system": "npm run build --workspace=libs/design-system",
    "build:ui-components": "npm run build --workspace=libs/ui-components",
    "build:scoreboard": "npm run build --workspace=apps/scoreboard",
    "build:host": "npm run build --workspace=apps/host",
    "build:stats-panel": "npm run build --workspace=apps/stats-panel",
    "build:libs": "run-s build:design-system build:ui-components",
    "build:remotes": "run-p build:stats-panel build:scoreboard",
    "build": "run-s build:libs build:remotes build:host",
    "preview:scoreboard": "npm run preview --workspace=apps/scoreboard",
    "preview:stats-panel": "npm run preview --workspace=apps/stats-panel",
    "dev:stats-panel": "npm run dev --workspace=apps/stats-panel",
    "dev:build-remotes": "run-s build:stats-panel"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vanilla-extract/vite-plugin": "^5.2.2",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.1.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.12.0",
    "jsdom": "^29.1.1",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.8.1",
    "typescript-eslint": "^8.15.0",
    "vitest": "^4.1.9"
  }
}
