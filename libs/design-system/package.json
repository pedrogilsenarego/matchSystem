{
  "name": "design-system",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "sideEffects": [
    "./src/theme.css.ts",
    "./src/global.css.ts"
  ],
